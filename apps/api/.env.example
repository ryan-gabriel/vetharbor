# Local development defaults only - never put real credentials in the repo
# (AGENTS.md §3.4). Copy to apps/api/.env; the file is git-ignored.

VETHARBOR_PROFILE=dev
VETHARBOR_ENVIRONMENT=dev
VETHARBOR_DATABASE_URL=postgresql+psycopg://vetharbor:vetharbor@localhost:55432/vetharbor
VETHARBOR_LOG_LEVEL=INFO

# Providers: `fake` needs no key and is the default in dev and CI
# (AGENTS.md §3.5). Switch to `gemini` to see real embeddings/LLM replies
# locally; the adapter fails fast if the key is missing.
VETHARBOR_LLM_PROVIDER=fake
VETHARBOR_EMBEDDING_PROVIDER=fake

# Gemini (lite profile). GEMINI_API_KEY has no default and is read by name, so
# it stays compatible with Google's own docs. Keep it in .env or the deployment
# environment - never in a tracked file, log line or test fixture.
# GEMINI_API_KEY=
# VETHARBOR_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# VETHARBOR_GEMINI_LLM_MODEL=gemini-3.5-flash-lite

# M3 (ADR-009): OIDC verification. Leave unset until the auth milestone.
# VETHARBOR_AUTH_ISSUER=
# VETHARBOR_AUTH_AUDIENCE=
